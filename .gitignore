# Backups install.sh makes when it displaces a real file
*.bak
*.bak-*
*~

# Machine-specific or secret shell settings. Sourced by .zshrc if present, but
# never tracked -- put API keys, tokens and per-machine PATH tweaks here.
.zshrc.local
.bashrc.local
.gitconfig.local

# Editor and OS noise
.swp
.swo
.DS_Store

# StartPage's wallpapers -- 88M of images, and not load-bearing the way the sway
# wallpapers are: no config names a specific file, and the page degrades to
# "No wallpapers indexed" on its own. wallpapers.js goes with them because it is
# generated from, and only refers to, files that are not tracked.
#
# WARNING: these live inside the repo working tree, so `git clean -xdf` here would
# delete them. Back them up before running that.
startpage/StartPage/wallpaper-picutes/
startpage/StartPage/wallpapers.js

# Agent scratch notes. Previously only in .git/info/exclude, which is local to one
# clone and never travels -- so a second clone could have committed these.
.claude/
