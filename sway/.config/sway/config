# Sway configuration — albos / Fedora 44 / Acer laptop (Intel i915)
#
# Full prose guide, including the reasoning behind the workspace scheme:
#   ~/dotfiles/docs/sway-guide.md
#
# Reference: man 5 sway.  Validate an edit with `sway --validate` BEFORE
# reloading with $mod+Shift+c.
#
# Section order below is deliberate and worth keeping:
#   1 variables · 2 input · 3 outputs · 4 appearance · 5 window rules
#   6 startup · 7 key bindings · 8 modes · 9 include
# Only two orderings actually matter to sway: variables must be `set` before
# they are used, and the `include` on the last line must STAY last, because
# config.d/ loads after this file and overrides it.


### 1. Variables ###########################################################

# Logo key. Mod1 is Alt (not Super — most sway tutorials online assume Mod4).
set $mod Mod1

set $left h
set $down j
set $up k
set $right l

# Preferred terminal emulator
set $term kitty

# Helper scripts. Every use below is inside `exec`, which runs through a
# shell, so the ~ expands correctly.
set $scripts ~/.config/sway/scripts


### 2. Input devices #######################################################

# caps lock becomes esc; shift+caps is still caps lock.
# Both shifts together toggle the us/ir keyboard layout.
input "type:keyboard" {
    xkb_layout "us,ir"
    xkb_options "caps:escape_shifted_capslock,grp:shifts_toggle"
}

input "type:touchpad" {
    natural_scroll enable
}


### 3. Outputs and workspaces ##############################################

# Laptop (eDP-1) on the LEFT, external monitor (HDMI-A-1, LG W2286) on the
# RIGHT. Move the mouse right to reach the right monitor.
#
# NOTE: this used to say DP-1, which is not a real output on this machine, so
# sway silently ignored both lines. The correct name comes from
# `swaymsg -t get_outputs`. No resolution is forced: HDMI-A-1's native mode is
# 1680x1050 and looks better than the 1024x768 that was configured here before.
output eDP-1 position 0 0
output HDMI-A-1 position 1366 0

# Pin workspace numbers to outputs by parity: ODD = laptop (eDP-1), EVEN =
# external (HDMI-A-1). The point is that a number tells you which screen it is
# on before you press it, so $mod+3 always means "the laptop's second desktop"
# no matter where you are looking right now.
#
# This also drives ws-cycle.py: when $mod+period appends a workspace it skips
# numbers pinned to the OTHER output, so the laptop grows 1 -> 3 -> 5 -> 7 and
# the external grows 2 -> 4 -> 6 on its own. Nothing in the script hardcodes
# odd/even; it just reads these lines. Change the pins and the script follows.
#
# Only 1-10 are pinned, because only those have a $mod+<number> key. Past 10
# the script infers the pattern from these lines (stride 2, odd here) and keeps
# it going, so the laptop appends 11, 13 and the external appends 12, 14. Do
# not rely on the numbers alone to do that: with nothing pinned above 10 the
# plain "next free number" rule would hand the external 11 and break parity.
#
# Caveat: `workspace N output ...` does not affect workspaces that ALREADY
# exist (see man 5 sway), so it only steers ones created from now on.
workspace 1 output eDP-1
workspace 3 output eDP-1
workspace 5 output eDP-1
workspace 7 output eDP-1
workspace 9 output eDP-1

workspace 2 output HDMI-A-1
workspace 4 output HDMI-A-1
workspace 6 output HDMI-A-1
workspace 8 output HDMI-A-1
workspace 10 output HDMI-A-1


### 4. Appearance ##########################################################

# Wallpaper: sway's native bg applies the image to every output.
output * bg /home/albos/Pictures/wallpapers/02.png fill

# 1-pixel border, no title bar. Alternatives: normal, none, pixel <n>.
default_border pixel 1

# Drag floating windows by holding $mod and the left mouse button.
floating_modifier $mod normal


### 5. Window rules ########################################################

# ── FIX: "black background on second monitor (HDMI-A-1)" ────────────────────
# Symptom : after reboot the external monitor showed a solid black screen
#           instead of the wallpaper.
# Cause   : it was NOT the wallpaper/PNG. An invisible helper window,
#           "xwaylandvideobridge" (X11 screen-share bridge, pulled in by
#           PipeWire/KDE screen sharing), launched FULLSCREEN on HDMI-A-1 and
#           covered the wallpaper with a transparent/black surface.
# How we  : 1) `swaymsg output '*' bg '#3366ff' solid_color` -> still black,
#  found it    so the image was innocent.
#           2) `swaymsg -t get_tree` -> showed xwaylandvideobridge fullscreen
#              on HDMI-A-1.
# Fix     : force that window to be floating, invisible, never fullscreen, and
#           parked in the scratchpad so it can never grab a monitor again.
for_window [class="xwaylandvideobridge"] floating enable, opacity 0, fullscreen disable, move to scratchpad
# ────────────────────────────────────────────────────────────────────────────


### 6. Startup programs ####################################################

# exec_always re-runs on every reload; exec runs ONLY at sway startup.
# That distinction matters below: editing the swayidle timers and pressing
# $mod+Shift+c will NOT apply them — the old swayidle keeps its old timers.
# You must `pkill -x swayidle` and re-run it, or log out and back in.

# Bar. The script kills the old instance first, so reloading never stacks
# up duplicate bars.
exec_always $scripts/waybar-restart.sh

# Notification daemon. Sway ships no notification support at all, so without
# this nothing DISPLAYS notifications — `notify-send` only sends them.
#
# It is not merely cosmetic here. D-Bus still advertises
# org.freedesktop.Notifications as activatable, left over from KDE, so with no
# daemon running notify-send does not fail fast: it waits out the full
# activation timeout, measured at 85 seconds. Fedora's brightness and volume
# bindings in /usr/share/sway/config.d/ each fire a notification, so every key
# press was leaving a process stuck for that long.
#
# `pkill -x mako` first, so reloading does not stack up duplicates the way an
# unguarded exec_always would. Wrapped in `sh -c` so the `;` is unambiguously a
# shell separator rather than something sway's own parser might act on.
exec_always sh -c 'pkill -x mako; mako'

# Idle chain: lock at 15:00, blank the screens at 15:05, lock before sleep.
#
# The $scripts paths here are deliberately UNQUOTED while the swaymsg commands
# are quoted. $scripts expands to a ~ path, and a shell only expands ~ when it
# is unquoted — '~/...' and "~/..." both stay literal and swayidle would fail
# to find the script. The paths contain no spaces, so they remain one argument.
# The swaymsg commands do contain spaces, so they must keep their quotes.
exec swayidle -w \
    timeout 900 $scripts/lock.sh \
    timeout 905 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep $scripts/lock.sh


### 7. Key bindings ########################################################

## 7.1 Basics

    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window (two bindings, both intentional)
    bindsym $mod+Shift+q kill
    bindsym $mod+x kill

    # Application launcher
    bindsym $mod+space exec rofi -show drun

## 7.2 Focus and movement

    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

## 7.3 Workspaces

    # Absolute jumps. With the parity pins in section 3, these also choose a
    # MONITOR: odd numbers are on the laptop, even ones on the external, so
    # $mod+4 from the laptop moves your focus to the external screen.
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

    # ── Walk the workspaces that exist ON THE CURRENT MONITOR ───────────────
    # The number keys above jump to one fixed workspace wherever it lives.
    # These instead treat the current monitor's workspaces as a strip you walk
    # left and right, so you can flip between them without remembering numbers.
    #
    #   $mod+period  -> one step right. At the last workspace there is nowhere
    #                   left to go, so it APPENDS a new empty workspace and
    #                   focuses it. Walking off the end is how you get a new
    #                   desktop; there is no separate "create" key.
    #   $mod+comma   -> one step left. Stops at the first one. Never creates.
    #
    # Neither wraps around, because at the last workspace $mod+period has to
    # mean either "wrap to the first" or "append a new one" and it cannot be
    # both. Sway's built-in `workspace next_on_output`/`prev_on_output` do the
    # walking but always wrap and never append, hence the script.
    bindsym $mod+period exec $scripts/ws-cycle.py next
    bindsym $mod+comma  exec $scripts/ws-cycle.py prev

    # Same idea, but drag the focused window along with you. Uses the same
    # script so these stay consistent with the two above; the built-in
    # `move container to workspace next_on_output` would wrap instead of append.
    bindsym $mod+Shift+period exec $scripts/ws-cycle.py next --take
    bindsym $mod+Shift+comma  exec $scripts/ws-cycle.py prev --take
    # ────────────────────────────────────────────────────────────────────────

## 7.4 Layout

    bindsym $mod+b splith
    bindsym $mod+Shift+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent

## 7.5 Scratchpad

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    bindsym $mod+minus scratchpad show

## 7.6 Session and system

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Lock the screen now
    bindsym $mod+Shift+x exec $scripts/lock.sh

    # Next wallpaper
    bindsym $mod+Shift+w exec $scripts/wallpaper-next.sh

    # Notifications: toggle do-not-disturb, and dismiss what is on screen.
    # DND hides popups but still receives them — `makoctl list` shows what
    # arrived while it was on. See docs/mako-guide.md.
    bindsym $mod+n exec makoctl mode -t dnd
    bindsym $mod+Shift+n exec makoctl dismiss -a

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'


### 8. Modes ###############################################################

# A mode is a modal keymap, like vim's insert mode. $mod+r enters resize mode,
# where h/j/k/l and the arrow keys resize instead of moving focus.
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


### 9. Include — MUST stay last ############################################

# Fedora's layered include, merging three directories in priority order:
#   /usr/share/sway/config.d/  (package)  <  /etc/sway/config.d/  (admin)
#   <  ~/.config/sway/config.d/  (yours, wins)
# Files are matched BY FILENAME, and a later directory replaces an earlier
# file of the same name outright. That is why the empty config.d/90-bar.conf
# is load-bearing: it shadows Fedora's bar block so waybar is not started
# twice. Deleting it would give you two bars.
#
# Because this loads AFTER everything above, anything in config.d/ overrides
# this file. Keep it on the last line.
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
