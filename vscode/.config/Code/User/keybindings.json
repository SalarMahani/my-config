  {
    // Was alt+k -- sway binds $mod+k to focus-up. ctrl+shift+up also carries
    // terminal resizePaneUp, but that one is `when: terminalFocus` and this one
    // is `when: editorTextFocus`, so the two contexts never overlap.
    "key": "ctrl+shift+up",
    "command": "editor.action.moveLinesUpAction",
