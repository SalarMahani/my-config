    // The missing counterpart. VS Code's alt+down default was deleted below but
    // never re-bound, so moving a line DOWN had no key at all -- alt+j would not
    // have worked either, since sway binds $mod+Down and $mod+j to focus-down.
    "key": "ctrl+shift+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
