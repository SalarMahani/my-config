[
  {
    "key": "alt+h",
    "command": "-testing.toggleTestingPeekHistory",
    "when": "testing.isPeekVisible"

  },
  {
    "key": "alt+h",
    "command": "-editor.action.accessibilityHelpOpenHelpLink",
    "when": "accessibilityHelpIsShown"
  },
  {
    "key": "space + w",
    "command": "workbench.action.openGlobalKeybindings"
  },
  {
    "key": "ctrl+k ctrl+s",
    "command": "-workbench.action.openGlobalKeybindings"
  },
  {
    "key": "alt+k",
    "command": "-keybindings.editor.recordSearchKeys",
    "when": "inKeybindings && inKeybindingsSearch"
  },
  {
    "key": "alt+k",
    "command": "-editor.action.accessibilityHelpConfigureKeybindings",
    "when": "accessibilityHelpIsShown && accessibleViewHasUnassignedKeybindings"
  },
  {
    // Move the current line, vim-style: k up, j down. Was alt+k (dead to sway,
    // which binds $mod+k to focus-up), then briefly ctrl+shift+<arrow>.
    //
    // Bare ctrl+k is safe here: it is normally VS Code's chord PREFIX, but this
    // config has no active `ctrl+k <key>` chords left to break. Both are scoped
    // to editorTextFocus so the terminal still receives ^J and ^K, which are a
    // literal newline and a control character respectively.
    //
    // ctrl+j/ctrl+k are also bound to selectNext/PrevCodeAction further down
    // this file. That is deliberate: those carry `when: codeActionMenuVisible`
    // and sit LATER, so they win while the quick-fix menu is open and these
    // apply everywhere else.
    "key": "ctrl+k",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    // VS Code's alt+down default was deleted below and never re-bound, so
    // moving a line DOWN had no key at all until this was added.
    "key": "ctrl+j",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+up",
    "command": "-editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "j",
    "command": "-list.focusDown",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "j",
    "command": "-notebook.focusNextEditor",
    "when": "editorTextFocus && inputFocus && notebookEditorFocused && vim.mode == 'Normal' && notebookEditorCursorAtBoundary != 'none' && notebookEditorCursorAtBoundary != 'top'"
  },
  {
    "key": "alt+down",
    "command": "-editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+e",
    "command": "-workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled"
  },
  {
    "key": "ctrl+shift+e",
    "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
    "when": "inFilesPicker && inQuickOpen"
  },
  {
    "key": "alt+l alt+o",
    "command": "-extension.liveServer.goOnline",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+l alt+c",
    "command": "-extension.liveServer.goOffline",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+l",
    "command": "-toggleSearchEditorContextLines",
    "when": "inSearchEditor"
  },
  {
    "key": "alt+l",
    "command": "-toggleFindInSelection",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "down",
    "command": "-list.focusDown",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "k",
    "command": "-notebook.focusPreviousEditor",
    "when": "editorTextFocus && inputFocus && notebookEditorFocused && vim.mode == 'Normal' && notebookEditorCursorAtBoundary != 'bottom' && notebookEditorCursorAtBoundary != 'none'"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused && !renameInputFocused"
  },
  {
    "key": "up",
    "command": "-list.focusUp",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "ctrl+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.chat.newChat",
    "when": "chatIsEnabled && inChat && chatLocation == 'panel'"
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.openChat",
    "when": "chatIsEnabled && inChat && inChatEditor"
  },
  {
    "key": "ctrl+n",
    "command": "-chatEditor.action.undoHunk",
    "when": "chatEdits.cursorInChangeRange && chatEdits.hasEditorModifications && editorFocus && !chatEdits.isCurrentlyBeingModified || chatEdits.cursorInChangeRange && chatEdits.hasEditorModifications && notebookCellListFocused && !chatEdits.isCurrentlyBeingModified"
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.files.newUntitledFile"
  },
  {
    "key": "ctrl+n",
    "command": "-extension.vim_ctrl+n",
    "when": "editorTextFocus && vim.active && vim.use<C-n> && !inDebugRepl || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'SearchInProgressMode'"
  },
  {
    "key": "alt+n",
    "command": "-workbench.action.chat.nextQuestion",
    "when": "chatHasQuestionCarousel && inChat && inChatQuestionCarousel"
  },
  {
    "key": "alt+.",
    "command": "-auto-close-tag.closeTag"
  },
  {
    // Next editor tab. Was alt+. (dead -- sway binds $mod+period to
    // ws-cycle.py), then ctrl+. until that key was given to terminal
    // navigation. Mirrors `.` = next editor in vim normal mode, so it works in
    // insert mode too. Left unscoped, so it reaches editor tabs from the
    // terminal as well.
    "key": "ctrl+shift+.",
    "command": "workbench.action.nextEditor",
    "when": "!panelFocus"
  },
  {
    "key": "ctrl+pagedown",
    "command": "-workbench.action.nextEditor"
  },
  {
    // Previous editor tab -- the sibling of the rule above, same history.
    "key": "ctrl+shift+,",
    "command": "workbench.action.previousEditor",
    "when": "!panelFocus"
  },
  {
    "key": "ctrl+pageup",
    "command": "-workbench.action.previousEditor"
  },
  {
    // Previous terminal. Moved off ctrl+p so zsh gets ^p back (.zshrc:
    // history-search-backward), then off ctrl+shift+, onto the plain ctrl+
    // pair, which is the shorter reach for the thing done most often.
    //
    // Bare `,` and `.` -- what vim normal mode uses for editor tabs -- are NOT
    // an option here: in a terminal those are literal characters, and VS Code
    // has no context key exposing zsh's vi mode, so a bare binding would make
    // `cd ..` untypeable. Only modifier combinations are safe in a terminal.
    "key": "ctrl+,",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
  },
  {
    "key": "ctrl+pageup",
    "command": "-workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
  },
  {
    // Next terminal -- sibling of the rule above.
    "key": "ctrl+.",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
  },
  {
    "key": "ctrl+pagedown",
    "command": "-workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
  },
  {
    "key": "ctrl+w",
    "command": "-workbench.action.closeActiveEditor"
  },
  {
    "key": "ctrl+m",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  {
    "key": "ctrl+shift+`",
    "command": "-workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  {
    "key": "shift+enter",
    "command": "-editor.action.previousMatchFindAction",
    "when": "editorFocus && findInputFocussed"
  },
  {
    "key": "shift+enter",
    "command": "-notebook.cell.executeAndSelectBelow",
    "when": "notebookCellListFocused && !inlineChatFocused && notebookCellType == 'markup' || notebookCellListFocused && notebookMissingKernelExtension && !inlineChatFocused && !notebookCellExecuting && notebookCellType == 'code' || notebookCellListFocused && !inlineChatFocused && !notebookCellExecuting && notebookCellType == 'code' && notebookKernelCount > 0 || notebookCellListFocused && !inlineChatFocused && !notebookCellExecuting && notebookCellType == 'code' && notebookKernelSourceCount > 0"
  },
  {
    "key": "shift+enter",
    "command": "-workbench.action.terminal.findNext",
    "when": "terminalFindInputFocused && terminalHasBeenCreated || terminalFindInputFocused && terminalProcessSupported"
  },
  {
    "key": "shift+enter",
    "command": "-workbench.action.terminal.sendSequence",
    "when": "config.terminal.integrated.enableWin32InputMode && terminalFocus && terminalShellIntegrationEnabled && !accessibilityModeEnabled && terminalShellType == 'pwsh'"
  },
  {
    "key": "shift+enter",
    "command": "-acceptAlternativeSelectedSuggestion",
    "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "shift+enter",
    "command": "-editor.action.extensioneditor.findPrevious",
    "when": "webviewFindWidgetFocused && !editorFocus && activeEditor == 'workbench.editor.extension'"
  },
  {
    "key": "shift+enter",
    "command": "-editor.action.webvieweditor.findPrevious",
    "when": "webviewFindWidgetFocused && !editorFocus && activeEditor == 'WebviewEditor'"
  },
  {
    "key": "shift+enter",
    "command": "-editor.refocusCallHierarchy",
    "when": "callHierarchyVisible"
  },
  {
    "key": "shift+enter",
    "command": "-editor.refocusTypeHierarchy",
    "when": "typeHierarchyVisible"
  },
  {
    "key": "shift+enter",
    "command": "-interactive.execute",
    "when": "config.interactiveWindow.executeWithShiftEnter && isCompositeNotebook && activeEditor == 'workbench.editor.interactive'"
  },
  {
    "key": "shift+enter",
    "command": "-quickInput.accept",
    "when": "inQuickInput && !isComposing && quickInputType != 'quickWidget'"
  },
  {
    "key": "shift+enter",
    "command": "-repl.execute",
    "when": "config.interactiveWindow.executeWithShiftEnter && isCompositeNotebook && !notebookCellListFocused && activeEditor == 'workbench.editor.repl'"
  },
  {
    "key": "shift+enter",
    "command": "-workbench.action.browser.findPrevious",
    "when": "browserFindWidgetFocused && activeEditor == 'workbench.editor.browser'"
  },
  {
    // Was alt+enter -- sway binds $mod+Return to launch kitty.
    "key": "ctrl+enter",
    "command": "workbench.action.unifiedQuickAccess"
  },
  {
    // Scoped to !terminalFocus: ^I *is* Tab, so an unrestricted binding killed
    // the terminal instead of completing a path. Killing it from the editor --
    // the usual direction, and what vim-normal-mode `I` already does -- still works.
    "key": "ctrl+i",
    "command": "workbench.action.terminal.kill",
    "when": "!terminalFocus"
  },
  {
    // The same kill, from INSIDE the terminal -- the direction the rule above
    // deliberately gives up. Was alt+i, which sway now eats.
    //
    // ctrl+i cannot be reused here for the reason given above: ^I is Tab. Any
    // plain ctrl+<letter> has that problem, because it IS a control character,
    // and terminal.kill sits in VS Code's default
    // `terminal.integrated.commandsToSkipShell`, so VS Code swallows the key
    // before zsh ever sees it. Adding Shift is what makes this safe: ctrl+
    // shift+i is not a control character, so there is nothing for it to steal.
    //
    // Scoped to terminalFocus rather than left bare, which costs nothing and
    // keeps a default: Format Document is ctrl+shift+i on Linux only
    // (`linux:{primary:3111}`) and is scoped to editorTextFocus, so the two
    // never overlap. Same trick as ctrl+, above, where scoping to the terminal
    // leaves Open Settings alone everywhere else.
    "key": "ctrl+shift+i",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },
  {
    // Panel-scoped siblings of the two above. These must stay LATER in the file
    // than the plain nextEditor/previousEditor entries: VS Code resolves a key
    // collision by taking the last rule whose `when` matches, so this ordering
    // is what makes ctrl+. mean "next panel view" while the panel has focus and
    // "next editor" everywhere else.
    // Walk the PANEL's tabs -- Terminal, Output, Problems, Debug Console --
    // from anywhere in the panel, the terminal included. Plain ctrl+. cannot be
    // used for this: it belongs to terminal-to-terminal navigation, and the
    // terminal lives IN the panel, so `panelFocus` is true while it has focus
    // and the two would fight over the same key.
    //
    // Pairs with the editor-tab rules above, which are scoped `!panelFocus`.
    // Same two keys, and which kind of tab they walk depends on where you are
    // standing: in the panel they move between panel views, everywhere else
    // between editor tabs. The two conditions are exact complements, so only
    // one can ever match.
    "key": "ctrl+shift+.",
    "command": "workbench.action.nextPanelView",
    "when": "panelFocus"
  },
  {
    "key": "ctrl+shift+,",
    "command": "workbench.action.previousPanelView",
    "when": "panelFocus"
  },
  {
    // Moved off ctrl+k / ctrl+j, which had NO `when` clause at all and so fired
    // everywhere -- including mid-typing in the terminal, where ^J is a literal
    // newline. Unlike resizePaneLeft/Right these two have no Linux default to
    // fall back on (VS Code ships them mac-only), so they are re-homed here
    // rather than deleted, completing the ctrl+shift+<arrow> family.
    // Resize the terminal, vim-style: k taller, j shorter.
    //
    // NOT terminal.resizePaneUp/Down, which is what used to be here. That
    // command begins `if (!this._splitPaneContainer) return` -- it resizes panes
    // WITHIN a split terminal and does nothing at all with a single one, so the
    // binding had been inert since long before it moved here.
    //
    // increase/decreaseViewHeight are named misleadingly. They do NOT resize the
    // focused view -- both are hardcoded to the editor part:
    //
    //   increaseViewHeight  "Increase Editor Height"
    //                       resizePart(0, +INC, ..., "workbench.parts.editor")
    //   decreaseViewHeight  "Decrease Editor Height"
    //                       resizePart(0, -INC, ..., "workbench.parts.editor")
    //
    // (The focused-view commands are increase/decreaseViewSize, without the
    // part argument.) So the effect on the terminal is the same wherever focus
    // happens to be, and no `when` clause is needed:
    //
    //   editor shorter -> terminal taller   -> k
    //   editor taller  -> terminal shorter  -> j
    //
    // This previously carried a terminalFocus/editorFocus pair on the false
    // assumption that these resized the focused view, which made the keys work
    // in the editor and behave backwards in the terminal.
    //
    // Overrides two VS Code defaults: ctrl+shift+k (Delete Line, which vim's
    // `dd` already covers) and ctrl+shift+j (Toggle Search Details, already
    // unbound further down this file).
    "key": "ctrl+shift+k",
    "command": "workbench.action.decreaseViewHeight"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.increaseViewHeight"
  },
  {
    "key": "ctrl+j",
    "command": "-workbench.action.togglePanel"
  },
  {
    "key": "ctrl+j",
    "command": "-extension.vim_ctrl+j",
    "when": "editorTextFocus && vim.active && vim.use<C-j> && !inDebugRepl"
  },
    // resizePaneLeft/Right used to sit on ctrl+h / ctrl+l, with VS Code's own
    // ctrl+shift+left / ctrl+shift+right defaults deleted to make room. Both
    // collided with the shell: ^H is backspace and ^L is clear-screen, so
    // neither ever reached zsh. Rather than invent replacement keys, the two
    // bindings and the two `-` removals are simply gone, which lets VS Code's
    // stock ctrl+shift+left / ctrl+shift+right come back on their own.
  {
    "key": "shift+enter",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    // Was alt+a -- sway binds $mod+a. Keeps the 'a' mnemonic. Note VS Code's own
    // default for this is ctrl+, which is now next/previous editor, and the
    // entry just below already removes it.
    "key": "ctrl+shift+a",
    "command": "workbench.action.openSettings"
  },
  {
    "key": "ctrl+,",
    "command": "-workbench.action.openSettings"
  },
  {
    "key": "alt+w",
    "command": "-toggleSearchEditorWholeWord",
    "when": "inSearchEditor && searchInputBoxFocus"
  },
  {
    "key": "alt+w",
    "command": "-workbench.action.terminal.toggleFindWholeWord",
    "when": "terminalFindVisible && terminalHasBeenCreated || terminalFindVisible && terminalProcessSupported"
  },
  {
    "key": "alt+w",
    "command": "-toggleFindWholeWord",
    "when": "editorFocus"
  },
  {
    "key": "alt+w",
    "command": "-toggleSearchWholeWord",
    "when": "searchViewletFocus"
  },
  // DELETED: shift+alt+h -> toggleActivityBarVisibility. Dead to sway
  // ($mod+Shift+h = move-left) and pointless anyway, since settings.json sets
  // "workbench.activityBar.location": "hidden" permanently.
  {
    "key": "ctrl+k ctrl+i",
    "command": "-editor.action.showHover",
    "when": "editorTextFocus"
  },
  {
    "key": "d",
    "command": "editor.action.increaseHoverVerbosityLevel",
    "when": "editorHoverVisible"
  },
  {
    "key": "f",
    "command": "editor.action.decreaseHoverVerbosityLevel",
    "when": "editorHoverVisible"
  },
  {
    "key": "ctrl+a",
    "command": "-extension.vim_ctrl+a",
    "when": "editorTextFocus && vim.active && vim.use<C-a> && !inDebugRepl"
  },
  {
    "key": "ctrl+c",
    "command": "-extension.vim_ctrl+c",
    "when": "editorTextFocus && vim.active && vim.overrideCtrlC && vim.use<C-c> && !inDebugRepl"
  },
  {
    "key": "ctrl+v",
    "command": "-extension.vim_ctrl+v",
    "when": "editorTextFocus && vim.active && vim.use<C-v> && !inDebugRepl"
  },
  {
    "key": "ctrl+o",
    "command": "workbench.action.files.openFolder",
    "when": "openFolderWorkspaceSupport"
  },
  {
    "key": "ctrl+k ctrl+o",
    "command": "-workbench.action.files.openFolder",
    "when": "openFolderWorkspaceSupport"
  },
  {
    "key": "ctrl+alt+meta+n",
    "command": "-welcome.showNewFileEntries",
    "when": "!isSessionsWindow"
  },
  {
    "key": "ctrl+shift+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+v",
    "command": "-editor.action.clipboardPasteAction"
  },
  {
    "key": "ctrl+f",
    "command": "-extension.vim_ctrl+f",
    "when": "editorTextFocus && vim.active && vim.use<C-f> && !inDebugRepl && vim.mode != 'Insert'"
  },
  {
  "key": "ctrl+shift+h",
  "command": "runCommands",
  "args": {
    "commands": [
      "workbench.action.toggleSidebarVisibility",
      "workbench.action.focusSideBar"
    ]
  },
  "when": "!sideBarVisible"
  },
  {
  "key": "ctrl+shift+h",
  "command": "workbench.action.toggleSidebarVisibility",
  "when": "sideBarVisible"
  },
  {
    "key": "alt+2",
    "command": "-workbench.action.openEditorAtIndex2"
  },
  {
    "key": "ctrl+8",
    "command": "-workbench.action.focusEighthEditorGroup"
  },
  {
  // terminalFocus deliberately REMOVED from this `when`. Escape has to reach
  // the shell: .zshrc runs `bindkey -v`, and Escape is the only way into vicmd,
  // so binding it here made vi normal mode unreachable in the panel.
  // To leave the terminal, ctrl+shift+l toggles the panel (see below).
  "key": "escape",
  "command": "workbench.action.focusActiveEditorGroup",
  "when":"sideBarFocus"
  },
  {
    "key": "ctrl+h",
    "command": "-editor.action.startFindReplaceAction",
    "when": "editorFocus || editorIsOpen"
  },
  {
    "key": "ctrl+shift+l",
    "command": "-notebook.selectAllFindMatches",
    "when": "config.notebook.multiCursor.enabled && notebookFindWidgetFocused || config.notebook.multiCursor.enabled && notebookCellEditorFocused && activeEditor == 'workbench.editor.notebook'"
  },
  {
    "key": "ctrl+shift+l",
    "command": "-selectAllSearchEditorMatches",
    "when": "inSearchEditor"
  },
  {
    "key": "ctrl+shift+l",
    "command": "-editor.action.selectHighlights",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+l",
    "command": "-addCursorsAtSearchResults",
    "when": "fileMatchOrMatchFocus && searchViewletVisible"
  },
  {
    "key": "ctrl+shift+j",
    "command": "-workbench.action.search.toggleQueryDetails",
    "when": "inSearchEditor || searchViewletFocus"
  },
  {
    "key": "ctrl+down",
    "command": "-selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  // DELETED: alt+k -> selectPrevSuggestion. Dead to sway ($mod+k = focus up),
  // and redundant: ctrl+p already does selectPrevSuggestion on the same
  // `suggestWidgetVisible` condition, with ctrl+n as its counterpart.
  {
    "key": "ctrl+up",
    "command": "-selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  {
    "key": "alt+a",
    "command": "-editor.action.accessibilityHelpConfigureAssignedKeybindings",
    "when": "accessibilityHelpIsShown && accessibleViewHasAssignedKeybindings"
  },
  {
    "key": "ctrl+\\",
    "command": "-workbench.action.splitEditor"
  },
  {
    // Reorder the current tab. Displaced twice: off ctrl+, when that took
    // previousEditor, then off ctrl+shift+, when THAT took previousEditor in
    // turn. ctrl+alt+ keeps the ,/. family intact and is safe -- sway binds no
    // ctrl combos, and ctrl+alt+<key> is not a terminal control character.
    "key": "ctrl+alt+,",
    "command": "workbench.action.moveEditorLeftInGroup",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+pageup",
    "command": "-workbench.action.moveEditorLeftInGroup"
  },
  {
    "key": "shift+alt+.",
    "command": "-editor.action.autoFix",
    "when": "textInputFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)quickfix\\b/"
  },
  {
    // Sibling of the rule above.
    "key": "ctrl+alt+.",
    "command": "workbench.action.moveEditorRightInGroup",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+pagedown",
    "command": "-workbench.action.moveEditorRightInGroup"
  },
  {
    "key": "ctrl+k ctrl+shift+\\",
    "command": "-workbench.action.joinEditorInGroup",
    "when": "sideBySideEditorActive"
  },
  {
    "key": "ctrl+shift+/",
    "command": "workbench.action.joinAllGroups"
  },
  {
    // Split the editor: send the CURRENT tab into a group on that side and
    // leave every other tab behind in the one you came from. VS Code creates
    // the group if it does not exist yet, so the first press is the split and
    // later presses just move tabs between the two halves.
    //
    // Same keys as terminal-to-terminal navigation, split by context:
    // `editorFocus` here, `terminalFocus` there, which are mutually exclusive.
    // The direction matches the rest of the ,/. family -- comma left, period
    // right.
    //
    // Duplicates <leader>sl / <leader>sr from settings.json, which do the same
