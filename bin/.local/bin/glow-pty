#!/usr/bin/env python3
"""Run glow on a pty we control, and relay its coloured output to stdout.

Why this exists
---------------
glow decides whether to emit colour by probing the terminal: it sends OSC 11
(background colour), OSC 10 (foreground colour) and a cursor-position request,
then waits for replies. Vim's built-in terminal emulator does not answer those
probes, so glow times out and falls back to its no-colour profile -- rendered
markdown inside `:Glow` came out completely monochrome, which defeats the point
of a custom style.

Verified that no environment variable fixes it: TERM=xterm-256color,
TERM=xterm-direct, COLORTERM=truecolor, CLICOLOR_FORCE=1 and FORCE_COLOR=1|3,
alone and combined, all still produced zero colour (measured with term_scrape()
on the resulting vim terminal buffer).

So: give glow a pty that DOES answer, and pass the bytes through. Vim's
terminal renders the resulting escape sequences correctly -- it handles
truecolour fine, it just does not speak the query half of the protocol.

Usage: glow-pty [any glow arguments]
"""

import os
import pty
import select
import sys

# Replies glow is waiting for. The colours reported here only steer glow's
# light/dark decision; the actual palette comes from the style file.
CURSOR_POSITION = b"\x1b[1;1R"
BACKGROUND = b"\x1b]11;rgb:1e1e/1e1e/1e1e\x1b\\"
FOREGROUND = b"\x1b]10;rgb:b8b8/bcbc/b9b9\x1b\\"


def main() -> int:
    pid, fd = pty.fork()
    if pid == 0:
        # Child: announce a capable terminal, then become glow.
        os.environ["TERM"] = "xterm-256color"
        os.environ["COLORTERM"] = "truecolor"
        try:
            os.execvp("glow", ["glow", *sys.argv[1:]])
        except FileNotFoundError:
            sys.stderr.write("glow-pty: glow is not installed\n")
            os._exit(127)

    out = sys.stdout.buffer
    while True:
        try:
            ready, _, _ = select.select([fd], [], [], 10.0)
        except (OSError, select.error):
            break
        if not ready:
            break
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            break
        if not chunk:
            break

        # Answer the probes rather than passing them to our own terminal --
        # otherwise the reply would come from the wrong place, or not at all.
        if b"\x1b[6n" in chunk:
            os.write(fd, CURSOR_POSITION)
        if b"]11;?" in chunk:
            os.write(fd, BACKGROUND)
        if b"]10;?" in chunk:
            os.write(fd, FOREGROUND)

        out.write(chunk)
        out.flush()

    try:
        os.close(fd)
    except OSError:
        pass
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    sys.exit(main())
