{
  "manifest_version": 3,
  "name": "StartPage",
  "version": "1.0.0",
  "description": "Personal new tab panel: wallpapers, dual calendar, bookmarks, activity and downloads.",

  "permissions": [
    "bookmarks", "history", "topSites", "favicon", "storage", "downloads"
  ],

  "icons": {
    "16": "icons/fire-16.png",
    "32": "icons/fire-32.png",
    "48": "icons/fire-48.png",
    "128": "icons/fire-128.png"
  },

  "background": { "service_worker": "sw.js" },

  "chrome_url_overrides": { "newtab": "newtab.html" },

  "content_scripts": [
    {
      "matches": ["file:///home/albos/StartPage/index.html"],
      "js": [
        "content/bridge.js",
        "content/bookmarks.js",
        "content/activity.js",
        "content/downloads.js"
      ],
      "css": ["content/panels.css"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    { "resources": ["_favicon/*"], "matches": ["file:///*"] }
  ]
}
